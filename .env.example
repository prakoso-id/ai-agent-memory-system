# ===== LLM Configuration =====
LLM_PROVIDER=lmstudio          # lmstudio | openrouter
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio          # Use your OpenRouter key if using openrouter
LLM_MODEL=qwen3.5-9b           # Model name as shown in LM Studio or OpenRouter
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe # Must match exact model name in LM Studio

# ===== Redis (Working Memory) =====
REDIS_URL=redis://localhost:6379

# ===== PostgreSQL (Episodic + Reflection Memory) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret
POSTGRES_DB=agent_memory

# ===== Qdrant (Semantic Memory) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_memory

# ===== Neo4j (Knowledge Graph) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent_secret

# ===== Agent Settings =====
MEMORY_RETRIEVAL_LIMIT=7
MEMORY_DECAY_FACTOR=0.01
WORKING_MEMORY_TTL=3600

# ===== API Server =====
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEYS=dev-key-change-me     # Comma-separated API keys for authentication
