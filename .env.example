# ===== LLM Configuration =====
LLM_PROVIDER=lmstudio          # lmstudio | openrouter
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio          # Use your OpenRouter key if using openrouter
LLM_MODEL=qwen3.5-9b           # Model name as shown in LM Studio or OpenRouter
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe # Must match exact model name in LM Studio

# ===== Database Server =====
# Ganti <DB_SERVER_IP> dengan IP lokal dedicated database server (misal: 192.168.1.x)
# Semua database berjalan di server tersebut, project ini terhubung via local network.
DB_SERVER_IP=192.168.1.100

# ===== Redis (Working Memory + Semantic Cache) =====
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:redis_secret@192.168.1.100:6380
REDIS_PASSWORD=redis_secret    # Harus sama dengan REDIS_PASSWORD di docker-compose DB server

# ===== PostgreSQL (Episodic + Reflection + Strategy + Evaluation Memory) =====
POSTGRES_HOST=192.168.1.100
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret
POSTGRES_DB=agent_memory

# ===== Qdrant (Semantic Memory / Vector Search) =====
QDRANT_URL=http://192.168.1.100:6340
QDRANT_API_KEY=your-qdrant-api-key    # Harus sama dengan QDRANT_API_KEY di .env DB server
QDRANT_COLLECTION=semantic_memory

# ===== Neo4j (Knowledge Graph) =====
NEO4J_URI=bolt://192.168.1.100:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret

# ===== Agent Settings =====
MEMORY_RETRIEVAL_LIMIT=7
MEMORY_DECAY_FACTOR=0.01
WORKING_MEMORY_TTL=3600

# ===== API Server =====
# Akses dari luar via Cloudflare Zero Trust Tunnel → port 3001 yang di-tunnel
API_PORT=3001
# Untuk akses lokal: tambahkan IP/hostname lokal
# Untuk akses via Cloudflare tunnel: tambahkan domain Cloudflare (misal: https://agent.yourdomain.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEYS=change-this-to-a-strong-random-key  # Gunakan: openssl rand -hex 32
