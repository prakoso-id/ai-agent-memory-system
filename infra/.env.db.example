# =================================================================
# AI Agent Memory System — Database Server Environment
#
# File ini digunakan pada dedicated home server database.
# Salin ke .env lalu jalankan: docker compose up -d
#
# PENTING: Semua password WAJIB diisi. Compose akan error
#          jika ada yang kosong (sengaja, untuk keamanan).
# =================================================================

# -----------------------------------------------------------------
# Bind Address
# IP address yang digunakan untuk expose port ke jaringan lokal.
# Gunakan IP LAN server ini (misal: 192.168.1.100) agar port hanya
# bisa diakses dari local network, bukan dari semua interface.
# Default 0.0.0.0 jika tidak diset (semua interface).
# -----------------------------------------------------------------
BIND_ADDRESS=192.168.1.100

# -----------------------------------------------------------------
# Redis
# -----------------------------------------------------------------
REDIS_PASSWORD=ganti-dengan-password-kuat-redis
# Batas memory Redis. Jika terlampaui, key lama dihapus (allkeys-lru).
REDIS_MAX_MEMORY=512mb

# -----------------------------------------------------------------
# Qdrant
# API key ini HARUS sama persis dengan QDRANT_API_KEY di .env project.
# Generate contoh: openssl rand -hex 32
# -----------------------------------------------------------------
QDRANT_API_KEY=ganti-dengan-api-key-kuat-qdrant
# Opsional: read-only key untuk client yang hanya perlu search
QDRANT_READ_API_KEY=

# -----------------------------------------------------------------
# Neo4j
# Password minimal 8 karakter, tidak boleh sama dengan username.
# -----------------------------------------------------------------
NEO4J_PASSWORD=ganti-dengan-password-kuat-neo4j
# Memory tuning — sesuaikan dengan RAM home server
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
