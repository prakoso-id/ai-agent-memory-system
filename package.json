{
  "name": "ai-agent-memory-system",
  "version": "1.0.0",
  "description": "Self-Evolving AI Agent with Persistent Memory Architecture",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "server": "bun run src/server.ts",
    "build": "tsc",
    "db:init": "bun run src/database/init.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tc001": "vitest run src/tests/tc-001.write-filter.test.ts",
    "test:tc002": "vitest run src/tests/tc-002.dedup.test.ts",
    "test:tc003": "vitest run src/tests/tc-003.context-aware.test.ts",
    "test:tc004": "vitest run src/tests/tc-004.composite-score.test.ts",
    "test:tc005": "vitest run src/tests/tc-005.edge-cases.test.ts",
    "test:tc006": "vitest run src/tests/tc-006.adaptive-learning.test.ts",
    "test:tc007": "vitest run src/tests/tc-007.reflection-impact.test.ts",
    "test:tc008": "vitest run src/tests/tc-008.context-compression.test.ts",
    "test:tc009": "vitest run src/tests/tc-009.conflict-confidence.test.ts",
    "test:tc010": "vitest run src/tests/tc-010.evaluation-decay.test.ts",
    "test:tc011": "vitest run src/tests/tc-011.promotion.test.ts",
    "example:phase1": "bun run src/examples/phase1-usage.ts",
    "example:phase2": "bun run src/examples/phase2-usage.ts",
    "example:phase3": "bun run src/examples/phase3-usage.ts",
    "example:phase4": "bun run src/examples/phase4-usage.ts",
    "test:tc012": "vitest run src/tests/tc-012.semantic-cache.test.ts",
    "test:tc013": "vitest run src/tests/tc-013.role-memory.test.ts",
    "test:tc014": "vitest run src/tests/tc-014.observability.test.ts",
    "test:dashboard": "vitest run src/tests/tc-012.semantic-cache.test.ts src/tests/tc-013.role-memory.test.ts src/tests/tc-014.observability.test.ts",
    "dashboard:dev": "cd dashboard && bun install && bun run dev",
    "dashboard:build": "cd dashboard && bun install && bun run build"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "neo4j-driver": "^5.27.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}